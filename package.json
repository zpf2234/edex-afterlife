{
  "name": "edex-afterlife",
  "productName": "eDEX Afterlife",
  "version": "0.1.0-preview.1",
  "description": "An unofficial community revival of eDEX-UI, the science fiction terminal emulator.",
  "keywords": [
    "desktop",
    "sci-fi",
    "gui",
    "portable",
    "tty",
    "terminal"
  ],
  "main": "src/_boot.js",
  "scripts": {
    "start": "electron src --nointro",
    "install-linux": "npm install && cd src && npm install && cd ..",
    "install-windows": "npm install && cd src && npm install && cd ..",
    "prebuild-linux": "rsync -a --info=progress2 src/ prebuild-src --exclude node_modules && node prebuild-minify.js && cd prebuild-src && npm install",
    "prebuild-darwin": "rsync -a src/ prebuild-src --exclude node_modules && node prebuild-minify.js && cd prebuild-src && npm install",
    "prebuild-windows": "mkdir prebuild-src && xcopy src\\* prebuild-src\\ /E /C /Q /Y && node prebuild-minify.js && cd prebuild-src && npm install",
    "build-linux": "./node_modules/.bin/electron-builder build -l --x64 --ia32 --arm64 --armv7l",
    "build-darwin": "./node_modules/.bin/electron-builder build -m",
    "build-windows": "node_modules\\.bin\\electron-builder build -w -c.npmRebuild=false",
    "postbuild-linux": "rm -R prebuild-src",
    "postbuild-darwin": "rm -R prebuild-src",
    "postbuild-windows": "rmdir /S /Q prebuild-src",
    "test": "rsync -a --info=progress2 src/ prebuild-src --exclude node_modules && node prebuild-minify.js && cd prebuild-src && npm install && snyk test && cd .. && rm -R prebuild-src",
    "init-file-icons": "git submodule update --init",
    "update-file-icons": "git submodule foreach git pull origin master && node file-icons-generator.js",
    "test:e2e": "node test/e2e.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zpf2234/edex-afterlife.git"
  },
  "author": "Gabriel 'Squared' SAILLARD <gabriel@saillard.dev> (https://gaby.dev)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/zpf2234/edex-afterlife/issues"
  },
  "homepage": "https://github.com/zpf2234/edex-afterlife#readme",
  "build": {
    "appId": "io.github.zpf2234.edexafterlife",
    "productName": "eDEX Afterlife",
    "publish": "github",
    "asar": true,
    "compression": "normal",
    "copyright": "Copyright © 2017-2021 Gabriel 'Squared' SAILLARD; 2026 eDEX Afterlife contributors",
    "directories": {
      "output": "dist",
      "app": "prebuild-src"
    },
    "forceCodeSigning": false,
    "npmRebuild": true,
    "artifactName": "eDEX-Afterlife-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "System",
      "icon": "media/linuxIcons"
    },
    "appImage": {
      "artifactName": "eDEX-Afterlife-Linux-${arch}.AppImage"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "media/icon.icns"
    },
    "dmg": {
      "artifactName": "eDEX-Afterlife-macOS-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "media/icon.ico"
    },
    "nsis": {
      "artifactName": "eDEX-Afterlife-Windows-${arch}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ]
  },
  "dependencies": {
    "clean-css": "5.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "mime-types": "^2.1.33",
    "node-json-minify": "1.0.0",
    "terser": "^5.9.0"
  },
  "optionalDependencies": {
    "cson-parser": "4.0.9"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  },
  "contributors": [
    "zpf2234"
  ]
}
